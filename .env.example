# Copy to .env (gitignored) and fill in real values before `docker-compose up`.

# Postgres admin-role password. Change this for any deployment reachable
# beyond your own machine.
POSTGRES_PASSWORD=postgres

# Passwords for the two roles the backend creates on startup
# (app_identity/app_user) -- pick your own, these are not the Postgres
# admin password above.
IDENTITY_DB_PASSWORD=
APP_DB_PASSWORD=

# Fernet key encrypting stored Discogs OAuth tokens at rest. Generate with:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# Real registered Discogs OAuth app credentials, from
# https://www.discogs.com/settings/developers. Callback URL to register:
# <BACKEND_BASE_URL>/api/auth/discogs/callback
DISCOGS_CONSUMER_KEY=
DISCOGS_CONSUMER_SECRET=

# The backend's own publicly-reachable base URL -- used to build the OAuth
# callback Discogs redirects back to. For a NAS/LAN deployment this is
# usually the NAS's LAN IP or hostname and the port the backend is exposed
# on (not necessarily 8000 -- see docker-compose.yml's frontend port mapping
# if the backend is only reachable through the frontend's reverse proxy).
BACKEND_BASE_URL=http://localhost:8000
